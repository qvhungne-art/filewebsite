# Cấu hình SePay & Tài khoản ngân hàng nhận thanh toán tự động
NEXT_PUBLIC_SEPAY_BANK_CODE=MB
NEXT_PUBLIC_SEPAY_BANK_NAME=MB Bank (Ngân hàng Quân Đội)
NEXT_PUBLIC_SEPAY_ACCOUNT_NUMBER=0987654321999
NEXT_PUBLIC_SEPAY_ACCOUNT_NAME=NGUYEN VAN HUNG

# API Key bảo mật Webhook từ SePay (Authorization: Apikey <SEPAY_WEBHOOK_API_KEY>)
SEPAY_WEBHOOK_API_KEY=vh_live_sepay_secret_key_change_me

# Chuỗi kết nối PostgreSQL / Prisma (tùy chọn khi nâng cấp từ in-memory lên DB)
DATABASE_URL=postgresql://user:password@localhost:5432/vanhung_xyz?schema=public
